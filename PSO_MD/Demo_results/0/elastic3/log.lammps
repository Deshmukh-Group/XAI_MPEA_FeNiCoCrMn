variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(1.1956119205847+${C3pos})
variable C35 equal 0.5*(1.1956119205847+-1.36208851855504)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
