variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 66.5835602453165
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -250.407710940905

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal -0.93206958061735
variable C2pos equal ${d2}
variable C2pos equal -0.89461058070155
variable C3pos equal ${d3}
variable C3pos equal -1.339891385654
variable C4pos equal ${d4}
variable C4pos equal 91.0405605497999
variable C5pos equal ${d5}
variable C5pos equal -0.594774322290448
variable C6pos equal ${d6}
variable C6pos equal 1.95827384880118

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(0.980443047599979+${C1pos})
variable C14 equal 0.5*(0.980443047599979+-0.93206958061735)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(0.69314865506821+${C2pos})
variable C24 equal 0.5*(0.69314865506821+-0.89461058070155)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(1.21796508136185+${C3pos})
variable C34 equal 0.5*(1.21796508136185+-1.339891385654)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C44 equal 0.5*(${C4neg}+${C4pos})
variable C44 equal 0.5*(91.1828891970003+${C4pos})
variable C44 equal 0.5*(91.1828891970003+91.0405605497999)
