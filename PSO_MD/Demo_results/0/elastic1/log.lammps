  triclinic box = (0.16990242 0.17232694 0.17095262) to (35.800098 35.797673 35.799047) with tilt (0.0000000 0.0000000 3.5628095e-05)
if "${dir} == 5" then    "change_box all xz delta ${delta} remap units box"
if "${dir} == 6" then    "change_box all xy delta ${delta} remap units box"

# Relax atoms positions

minimize ${etol} ${ftol} ${maxiter} ${maxeval}
minimize 1e-25 ${ftol} ${maxiter} ${maxeval}
minimize 1e-25 1e-25 ${maxiter} ${maxeval}
minimize 1e-25 1e-25 20000 ${maxeval}
minimize 1e-25 1e-25 20000 200000
