variable pxy1 equal -20.4733576312266
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -116.231895319431
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -78.2647146586768

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 157.908202589781
variable C2pos equal ${d2}
variable C2pos equal 160.292066631597
variable C3pos equal ${d3}
variable C3pos equal 256.64885736188
