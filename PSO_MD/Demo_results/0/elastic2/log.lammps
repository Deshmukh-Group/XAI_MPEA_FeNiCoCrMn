variable C5pos equal ${d5}
variable C5pos equal 0.953644476400939
variable C6pos equal ${d6}
variable C6pos equal 1.24665872613008

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(164.692547386022+${C1pos})
variable C13 equal 0.5*(164.692547386022+157.908202589781)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(162.490853111401+${C2pos})
variable C23 equal 0.5*(162.490853111401+160.292066631597)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(250.014730158728+${C3pos})
variable C33 equal 0.5*(250.014730158728+256.64885736188)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
