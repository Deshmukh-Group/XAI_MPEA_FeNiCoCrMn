# Input file for Stack Fault Energy surface of Nickel
# Richard Glaze, 2014
# --------------------- INITIALIZAITION ---------------------
clear
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (src/comm.cpp:98)
  using 1 OpenMP thread(s) per MPI task
units		metal
dimension	3
boundary	p p s
atom_style	atomic

read_data 	../data111_use2.dat
Reading data file ...
  orthogonal box = (0.0000000 0.0000000 -0.0037381121) to (44.054073 25.434631 35.308130)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  3600 atoms
  read_data CPU = 0.010 seconds
#variable x_displace equal -1*(${latparam1}/sqrt(6))
variable zcut equal 17.4363
variable xdim equal 43.5152
variable ydim equal 25.1235

# --------------------- ATOM DEFINITION ---------------------

region		1 block -.001 INF -.001 INF -.001 ${zcut} units box
region		1 block -.001 INF -.001 INF -.001 17.4363 units box
region 	2 block -.001 INF -.001 INF ${zcut} INF units box
region 	2 block -.001 INF -.001 INF 17.4363 INF units box

region		whole block INF INF INF INF INF INF units box


# --------------------- FORCE FIELDS ---------------------
pair_style meam/c
pair_coeff	* * ../library.meam Co Ni Cr Fe Mn ../CoNiCrFeMn.meam Mn Cr Co Fe Ni

# --------------------- SETTINGS ---------------------

compute peratom all pe/atom
compute eatoms all reduce sum c_peratom
compute csym all centro/atom fcc

min_style cg
minimize 1e-10 1e-10 10000 100000
