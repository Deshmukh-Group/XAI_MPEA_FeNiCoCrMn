variable C12 equal 0.5*(${C1neg}+${C1pos})
variable C12 equal 0.5*(161.548406526815+${C1pos})
variable C12 equal 0.5*(161.548406526815+161.522048113544)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
