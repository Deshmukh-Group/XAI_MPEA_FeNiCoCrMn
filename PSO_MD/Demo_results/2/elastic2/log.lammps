variable pxz1 equal -58.302508588559
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -90.1768717250041

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal 164.801355992508
variable C2neg equal ${d2}
variable C2neg equal 255.027349597713
variable C3neg equal ${d3}
variable C3neg equal 161.089065572915
