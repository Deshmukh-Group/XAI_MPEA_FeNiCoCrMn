variable pxy1 equal -7.83833326570578
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 63.2252845469584
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -165.748054923112

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 249.985273445994
variable C2pos equal ${d2}
variable C2pos equal 175.463108767355
variable C3pos equal ${d3}
variable C3pos equal 165.638926593894
