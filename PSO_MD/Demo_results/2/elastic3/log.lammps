variable pzz0 equal 0.0887595861139699
variable tmp equal pyz
variable pyz0 equal ${tmp}
variable pyz0 equal -187.241553569625
variable tmp equal pxz
variable pxz0 equal ${tmp}
variable pxz0 equal 30.8281868589976
variable tmp equal pxy
variable pxy0 equal ${tmp}
variable pxy0 equal 197.741438908262

variable tmp equal lx
variable lx0 equal ${tmp}
variable lx0 equal 35.6312090417755
variable tmp equal ly
variable ly0 equal ${tmp}
variable ly0 equal 35.6174271083241
variable tmp equal lz
variable lz0 equal ${tmp}
variable lz0 equal 35.625880705974

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-0.0886966552731267)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-0.0886966552731267)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-0.0815761762097814)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-0.0815761762097814)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-0.0887595861139699)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-0.0887595861139699)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
