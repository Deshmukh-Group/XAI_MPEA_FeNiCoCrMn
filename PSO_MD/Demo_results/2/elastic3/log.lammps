variable d4 equal -(v_pyz1--187.241553569625)/(v_delta/v_len0)*0.0001
variable d5 equal -(v_pxz1-${pxz0})/(v_delta/v_len0)*${cfac}
variable d5 equal -(v_pxz1-30.8281868589976)/(v_delta/v_len0)*${cfac}
variable d5 equal -(v_pxz1-30.8281868589976)/(v_delta/v_len0)*0.0001
